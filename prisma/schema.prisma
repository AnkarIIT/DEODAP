generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  passwordHash String
  name         String
  phone        String?
  role         Role            @default(CUSTOMER)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  addresses    Address[]
  orders       Order[]
  returnReqs   ReturnRequest[]
  reviews      Review[]
  wishlist     Wishlist[]

  @@index([email])
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  fullName  String
  phone     String
  street    String
  city      String
  state     String
  pincode   String
  landmark  String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    Order[]

  @@index([userId])
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?
  icon        String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([slug])
}

model Product {
  id               String            @id @default(uuid())
  title            String
  slug             String            @unique
  description      String
  shortDesc        String?
  vendor           String?
  categoryId       String
  mrp              Float
  sellingPrice     Float
  images           String[]
  thumbnail        String
  badge            String?
  rating           Float             @default(4.5)
  reviewCount      Int               @default(12)
  isTrending       Boolean           @default(false)
  isBestSeller     Boolean           @default(false)
  isNewArrival     Boolean           @default(false)
  isActive         Boolean           @default(true)
  specifications   Json?
  warrantyInfo     String?           @default("7-Day Replacement Guarantee")
  codAvailable     Boolean           @default(true)
  qualityScore     Int?
  metadata         Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  inventory        Inventory[]
  orderItems       OrderItem[]
  category         Category          @relation(fields: [categoryId], references: [id])
  variants         ProductVariant[]
  reviews          Review[]
  supplierProducts SupplierProduct[]
  wishlist         Wishlist[]

  @@index([slug])
  @@index([categoryId])
  @@index([isActive])
}

model ProductVariant {
  id         String      @id @default(uuid())
  productId  String
  sku        String      @unique
  title      String
  priceDiff  Float       @default(0)
  attributes Json
  stock      Int         @default(50)
  createdAt  DateTime    @default(now())
  orderItems OrderItem[]
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Supplier {
  id               String            @id @default(uuid())
  name             String            @unique
  slug             String            @unique
  code             String            @unique
  status           SupplierStatus    @default(ACTIVE)
  integrationType  IntegrationType   @default(MOCK_DEODAP)
  contactEmail     String?
  contactPhone     String?
  reliabilityScore Float             @default(94.5)
  avgDeliveryDays  Float             @default(3.5)
  returnScore      Float             @default(92.0)
  apiEndpoint      String?
  apiKey           String?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  inventory        Inventory[]
  supplierOrders   SupplierOrder[]
  supplierProducts SupplierProduct[]

  @@index([code])
}

model SupplierProduct {
  id                String          @id @default(uuid())
  supplierId        String
  productId         String
  externalProductId String
  costPrice         Float
  shippingCost      Float           @default(50)
  stock             Int             @default(100)
  isAvailable       Boolean         @default(true)
  leadTimeDays      Int             @default(3)
  lastSyncedAt      DateTime        @default(now())
  supplierOrders    SupplierOrder[]
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier          Supplier        @relation(fields: [supplierId], references: [id])

  @@unique([supplierId, externalProductId])
  @@index([productId])
  @@index([supplierId])
}

model Inventory {
  id             String   @id @default(uuid())
  productId      String
  supplierId     String
  totalStock     Int      @default(100)
  reservedStock  Int      @default(0)
  availableStock Int      @default(100)
  lowStockAlert  Int      @default(15)
  updatedAt      DateTime @updatedAt
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier       Supplier @relation(fields: [supplierId], references: [id])

  @@unique([productId, supplierId])
  @@index([productId])
}

model Order {
  id                  String           @id @default(uuid())
  orderNumber         String           @unique
  userId              String
  addressId           String
  subtotal            Float
  shippingFee         Float            @default(0)
  discount            Float            @default(0)
  couponCode          String?
  totalAmount         Float
  estimatedProfit     Float            @default(0)
  paymentMethod       PaymentMethod    @default(UPI_MANUAL)
  notes               String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  address             String?
  automationStatus    String           @default("PENDING")
  city                String?
  customerName        String?
  orderStatus         OrderStatus      @default(PENDING_PAYMENT)
  paymentStatus       String           @default("PENDING_PAYMENT")
  phone               String?
  pincode             String?
  state               String?
  supplierId          String?
  supplierOrderId     String?
  supplierOrderStatus String?
  supplierProductId   String?
  deliveryAddress     Address          @relation(fields: [addressId], references: [id])
  user                User             @relation(fields: [userId], references: [id])
  items               OrderItem[]
  statusLogs          OrderStatusLog[]
  payments            Payment[]
  returnRequests      ReturnRequest[]
  shipments           Shipment[]
  supplierOrders      SupplierOrder[]

  @@index([userId])
  @@index([orderNumber])
  @@index([orderStatus])
  @@index([paymentStatus, automationStatus])
}

model OrderItem {
  id                 String          @id @default(uuid())
  orderId            String
  productId          String
  variantId          String?
  quantity           Int             @default(1)
  unitPrice          Float
  totalPrice         Float
  supplierCost       Float?
  selectedSupplier   String?
  selectedSupplierId String?
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product            Product         @relation(fields: [productId], references: [id])
  variant            ProductVariant? @relation(fields: [variantId], references: [id])
  returnRequests     ReturnRequest[]

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id             String        @id @default(uuid())
  orderId        String
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  amount         Float
  currency       String        @default("INR")
  transactionRef String?
  upiPayerVpa    String?
  verifiedBy     String?
  verifiedAt     DateTime?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([transactionRef])
}

model Shipment {
  id                String    @id @default(uuid())
  orderId           String
  carrier           String    @default("Delhivery Express")
  trackingNumber    String    @unique
  trackingUrl       String?
  currentStatus     String    @default("Shipment manifest created")
  estimatedDelivery DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderStatusLog {
  id         String       @id @default(uuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  actorRole  String       @default("SYSTEM")
  createdAt  DateTime     @default(now())
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model SupplierOrder {
  id                String              @id @default(uuid())
  orderId           String
  supplierId        String
  supplierProductId String?
  externalOrderId   String?
  status            SupplierOrderStatus @default(PENDING)
  wholesaleCost     Float
  shippingCharged   Float
  trackingNumber    String?
  carrier           String?
  errorMessage      String?
  sentPayload       Json?
  receivedResponse  Json?
  items             Json?
  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  order             Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplier          Supplier            @relation(fields: [supplierId], references: [id])
  supplierProduct   SupplierProduct?    @relation(fields: [supplierProductId], references: [id])

  @@index([orderId])
  @@index([supplierId])
}

model ReturnRequest {
  id           String       @id @default(uuid())
  orderId      String
  orderItemId  String
  userId       String
  reason       String
  description  String?
  imageUrl     String?
  status       ReturnStatus @default(REQUESTED)
  adminNote    String?
  refundAmount Float?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem    OrderItem    @relation(fields: [orderItemId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([userId])
}

model Coupon {
  id              String    @id @default(uuid())
  code            String    @unique
  discountPercent Float?
  discountAmount  Float?
  minOrderValue   Float     @default(0)
  maxDiscount     Float?
  expiresAt       DateTime?
  isActive        Boolean   @default(true)
  usedCount       Int       @default(0)
  createdAt       DateTime  @default(now())

  @@index([code])
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

model Review {
  id               String   @id @default(uuid())
  productId        String
  userId           String
  rating           Int      @default(5)
  title            String
  comment          String
  verifiedPurchase Boolean  @default(true)
  createdAt        DateTime @default(now())
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ImportJob {
  id          String      @id @default(uuid())
  supplierId  String?
  fileName    String
  totalRows   Int         @default(0)
  successRows Int         @default(0)
  failedRows  Int         @default(0)
  status      String      @default("COMPLETED")
  logs        String?
  createdAt   DateTime    @default(now())
  rows        ImportRow[]
}

model ImportRow {
  id          String    @id @default(uuid())
  jobId       String
  rowNumber   Int
  rawTitle    String
  status      String
  errorReason String?
  createdAt   DateTime  @default(now())
  job         ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
}

model admin_sessions {
  id               String    @id @db.VarChar(64)
  admin_id         String    @db.VarChar(64)
  token_hash       String    @unique @db.VarChar(128)
  device           String?   @db.VarChar(128)
  browser          String?   @db.VarChar(128)
  os               String?   @db.VarChar(128)
  ip_address       String?   @db.VarChar(64)
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  last_activity_at DateTime? @default(now()) @db.Timestamptz(6)
  expires_at       DateTime  @db.Timestamptz(6)
  revoked          Boolean?  @default(false)
  is_current       Boolean?  @default(false)
  admins           admins    @relation(fields: [admin_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model admins {
  id             String           @id @db.VarChar(64)
  name           String           @db.VarChar(255)
  email          String           @unique @db.VarChar(255)
  role           String           @default("OPERATOR") @db.VarChar(64)
  password_hash  String           @db.VarChar(255)
  totp_secret    String?          @db.VarChar(64)
  totp_enabled   Boolean?         @default(false)
  status         String           @default("ACTIVE") @db.VarChar(64)
  created_at     DateTime?        @default(now()) @db.Timestamptz(6)
  last_login_at  DateTime?        @db.Timestamptz(6)
  admin_sessions admin_sessions[]
}

model audit_logs {
  id          String    @id @db.VarChar(64)
  timestamp   DateTime? @default(now()) @db.Timestamptz(6)
  admin_name  String    @db.VarChar(255)
  admin_email String    @db.VarChar(255)
  action      String    @db.VarChar(128)
  resource    String    @db.VarChar(128)
  resource_id String    @db.VarChar(128)
  description String
  ip_address  String?   @db.VarChar(64)
}

model catalog_sync_logs {
  id                   String    @id @db.VarChar(64)
  supplier_name        String?   @db.VarChar(255)
  products_added       Int?      @default(0)
  products_updated     Int?      @default(0)
  products_deactivated Int?      @default(0)
  status               String    @default("SUCCESS") @db.VarChar(64)
  duration_ms          Int?      @default(0)
  message              String?
  created_at           DateTime? @default(now()) @db.Timestamptz(6)
}

model categories {
  id            String    @id @db.VarChar(64)
  name          String    @db.VarChar(128)
  slug          String    @unique @db.VarChar(128)
  product_count Int?      @default(0)
  status        String?   @default("ACTIVE") @db.VarChar(64)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
}

model coupons {
  id               String    @id @db.VarChar(64)
  code             String    @unique @db.VarChar(64)
  discount_type    String    @db.VarChar(64)
  discount_value   Decimal   @db.Decimal(12, 2)
  min_order_amount Decimal?  @default(0) @db.Decimal(12, 2)
  usage_limit      Int?      @default(100)
  used_count       Int?      @default(0)
  starts_at        DateTime? @db.Timestamptz(6)
  expires_at       DateTime? @db.Timestamptz(6)
  status           String?   @default("ACTIVE") @db.VarChar(64)
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
}

model customers {
  id            String    @id @db.VarChar(64)
  name          String    @db.VarChar(255)
  email         String    @db.VarChar(255)
  phone         String?   @db.VarChar(64)
  total_orders  Int?      @default(0)
  total_spent   Decimal?  @default(0) @db.Decimal(12, 2)
  last_order_at DateTime? @db.Timestamptz(6)
  status        String?   @default("ACTIVE") @db.VarChar(64)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
}

model orders {
  id                  String    @id @db.VarChar(64)
  order_number        String    @unique @db.VarChar(64)
  customer_id         String?   @db.VarChar(64)
  customer_name       String    @db.VarChar(255)
  customer_email      String    @db.VarChar(255)
  customer_phone      String?   @db.VarChar(64)
  total_amount        Decimal   @db.Decimal(12, 2)
  shipping_fee        Decimal?  @default(0) @db.Decimal(12, 2)
  discount_amount     Decimal?  @default(0) @db.Decimal(12, 2)
  payment_method      String    @default("UPI") @db.VarChar(64)
  payment_status      String    @default("PENDING") @db.VarChar(64)
  order_status        String    @default("PAYMENT_REVIEW") @db.VarChar(64)
  utr_number          String?   @db.VarChar(128)
  payment_verified_at DateTime? @db.Timestamptz(6)
  payment_verified_by String?   @db.VarChar(128)
  rejection_reason    String?
  shipping_address    Json      @default("{}")
  items               Json      @default("[]")
  timeline            Json      @default("[]")
  supplier_order_id   String?   @db.VarChar(128)
  supplier_ordered_at DateTime? @db.Timestamptz(6)
  awb_number          String?   @db.VarChar(128)
  carrier             String?   @db.VarChar(128)
  tracking_status     String?   @db.VarChar(128)
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
  updated_at          DateTime? @default(now()) @db.Timestamptz(6)
}

model products {
  id                  String    @id @db.VarChar(64)
  sku                 String    @unique @db.VarChar(255)
  title               String    @db.VarChar(255)
  description         String?
  category            String    @db.VarChar(128)
  images              Json      @default("[]")
  selling_price       Decimal   @db.Decimal(12, 2)
  mrp                 Decimal   @db.Decimal(12, 2)
  stock               Int       @default(0)
  status              String    @default("PUBLISHED") @db.VarChar(64)
  sold_count          Int?      @default(0)
  revenue             Decimal?  @default(0) @db.Decimal(12, 2)
  supplier_id         String?   @db.VarChar(64)
  supplier_name       String?   @db.VarChar(255)
  supplier_product_id String?   @db.VarChar(128)
  supplier_sku        String?   @db.VarChar(128)
  supplier_cost       Decimal   @default(0) @db.Decimal(12, 2)
  supplier_url        String?
  margin              Decimal   @default(0) @db.Decimal(12, 2)
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
  updated_at          DateTime? @default(now()) @db.Timestamptz(6)
  slug                String?   @db.VarChar(255)
  rating              Decimal?  @db.Decimal(3, 2)
  review_count        Int?      @default(0)
  source_type         String?   @db.VarChar(64)
}

model returns {
  id             String    @id @db.VarChar(64)
  order_number   String    @db.VarChar(64)
  order_id       String?   @db.VarChar(64)
  customer_name  String    @db.VarChar(255)
  customer_email String    @db.VarChar(255)
  product_title  String    @db.VarChar(255)
  reason         String
  amount         Decimal   @db.Decimal(12, 2)
  refund_amount  Decimal   @db.Decimal(12, 2)
  status         String    @default("REQUESTED") @db.VarChar(64)
  requested_at   DateTime? @default(now()) @db.Timestamptz(6)
  notes          String?
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
}

model settings {
  key        String    @id @db.VarChar(128)
  value      Json
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
}

model suppliers {
  id                   String    @id @db.VarChar(64)
  name                 String    @db.VarChar(255)
  contact_person       String?   @db.VarChar(128)
  contact_email        String?   @db.VarChar(255)
  contact_phone        String?   @db.VarChar(64)
  integration_type     String?   @default("MANUAL") @db.VarChar(64)
  is_connected         Boolean?  @default(false)
  connection_details   String?
  last_sync_at         DateTime? @db.Timestamptz(6)
  product_count        Int?      @default(0)
  pending_orders_count Int?      @default(0)
  api_status_message   String?
  created_at           DateTime? @default(now()) @db.Timestamptz(6)
  website              String?   @db.VarChar(255)
}

enum Role {
  CUSTOMER
  ADMIN
  OPERATOR
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_REVIEW
  PAID
  FULFILMENT_PENDING
  CONFIRMED
  SUPPLIER_SELECTION
  SUPPLIER_ORDER_PENDING
  SUPPLIER_ORDERED
  SUPPLIER_ORDER_FAILED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURN_APPROVED
  RETURNED
  REFUNDED
  FAILED
}

enum PaymentStatus {
  PENDING
  UNDER_REVIEW
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  UPI_MANUAL
  MOCK_GATEWAY
  COD
  NETBANKING
}

enum IntegrationType {
  MOCK_DEODAP
  MANUAL_PORTAL
  OFFICIAL_API
  CSV_FEED
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
  RESTRICTED
}

enum SupplierOrderStatus {
  PENDING
  PLACED
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  REJECTED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  ITEM_RECEIVED
  REFUNDED
}
